turbodeploy() {
  ## test, build,push to the registry and deploy a service
  local env="${env:-}"          # <-- this is only required to pass shellcheck, can be omitted
  local service="${service:-}"  # <-- this is only required to pass shellcheck, can be omitted
  mustVar env       # the environment to deploy in
  mustVar service   # the name of the service to deploy
  
  
  h1 "Turbodeploy ${service} --> ${env}"
  
  # shMakefile read all the `shMakefile` scripts recursively.
  # We can then have a build function for all the services except some of them, 
  # we only need to declare a function named like the service `build-<service>` in 
  # an `shMakefile` down in the path  
  # ./shMakefile build --service=alice --> invoke build-alice @see ./services/alice/shMakefile    
  # ./shMakefile build --service=bob --> invoke build-kubeservice     
  if type -t "build-${service}" &>/dev/null; then
    "build-${service}"
  else
    build-kubeservice
  fi
  
  # push artifacts in their registries 
  if type -t "push-${service}" &>/dev/null; then
    "push-${service}"
  else
    push-kubeservice
  fi

  if type -t "deploy-${service}" &>/dev/null; then
    "deploy-${service}"
  else
    deploy-kubeservice
  fi
}

build-kubeservice() {
  ## standard build step
  mustVar service             # the name of the service to deploy
  local arch="${arch:-arm64}" # target build architecture - default arm64 
  local os="${os:-linux}"   # target build os - default linux 
  
  # jump in the service folder
  # build all `main.go` that are there
  pushd "services/${service}" || true
    shopt -s globstar
    for main in app/**/main.go; do
      name=$(basename "$(dirname "$main")")
      log "building main=${main} "
      
      CGO_ENABLED=0 GOOS="${os}" GOARCH="${arch}" go build -o "bin/${name}_${os}_${arch}" "./$main"      
    done

  popd || true
}

push-kubeservice() {
  ## Push the service artifacts in the service registry
  ## This function assumes
  ## - there is an helm chart with the same name as the service
  ## - there is a container image to build
  ## - chart and container are pushed to an AWS ECR registry
  ## Invoke this function with a proper AWS_PROFILE env set!   
  mustVar env
  mustVar service

  gitCommit=$(gitver)  
  r=${RANDOM} # add a random suffix to allow rebuild of images
  
  h1 "PUSHING service=${service} env=${env} git=${gitCommit}"

  local image_name="${service}"
  local chart_name="${service}"
  local image_tag="1.2_${gitCommit}-${r}"

  awsAccountId=$( aws sts get-caller-identity --query Account --output text )
  log "AWS account ${awsAccountId}"

  # get the latest pushed chart
  # shellcheck disable=SC2016 
  # backticks are for the cli, nothing to expand in the query 
  latestChart=$(
    aws ecr describe-images \
      --region eu-west-1 \
      --repository-name "${chart_name}" \
      --query='sort_by(imageDetails[?artifactMediaType==`application/vnd.cncf.helm.config.v1+json`], &imagePushedAt)[-1].imageTags[0]' \
      --output text
  )
  [ "$latestChart" = "None" ] && latestChart="1.0.0"

  chart_tag=$(increment_semver "${latestChart}")
  #chart_tag="1.1.0" #<-- useme for migration to the new repositories
  aws ecr get-login-password \
     --region eu-west-1 | helm registry login \
     --username AWS \
     --password-stdin "${awsAccountId}.dkr.ecr.eu-west-1.amazonaws.com"

  aws ecr get-login-password \
    --region eu-west-1 | docker login \
    --username AWS \
    --password-stdin "${awsAccountId}.dkr.ecr.eu-west-1.amazonaws.com"

  pushd "services/${service}" || exit

  log "Building & Pushing image image=${image_name}:${image_tag}"
  docker buildx build \
    --build-arg "ENV=${env}" \
    --platform=linux/arm64 \
    --push \
    -t "${awsAccountId}.dkr.ecr.eu-west-1.amazonaws.com/${image_name}:${image_tag}" .
  
  log "Pushing chart=${chart_name}:${chart_tag}"
  rm "${service}/Chart.yaml" || true
  rm "${service}/Chart.yamlbak" || true
  rm "${service}/values.yaml" || true

  echo "chart_name=${chart_name} chart_tag=${chart_tag} image_tag=${image_tag}"
  sed "s/#/${chart_tag}/" "${service}/Chart.yamltpl" > "${service}/Chart.yaml"  
  sed -ibak "s/@/${image_tag}/" "${service}/Chart.yaml"
  sed "s/@/${image_tag}/" "${service}/values.yamltpl" > "${service}/values.yaml"

  helm package "${service}"
  helm push "${chart_name}-${chart_tag}.tgz" "oci://${awsAccountId}.dkr.ecr.eu-west-1.amazonaws.com"
  rm "${chart_name}-${chart_tag}.tgz" || true
  log "chart pushed"
  
  popd || true

}

deploy-kubeservice() {
  ## Deploy the service artifacts in the service registry
  ## This function assumes
  ## - there is an helm chart with the same name of the service;
  ## - there is a container image to build;
  ## - chart and container are pushed to an AWS ECR registry;
  ## - the deployment is managed with Terraform;
  ##
  ## Invoke this function with a proper AWS_PROFILE env set! 
  mustVar env
  mustVar service
  h1 "DEPLOYING service=${service} env=${env}"

  if type -t "deploy-${service}" &>/dev/null; then
    "deploy-${service}"
    return $?
  fi
  
  awsAccountId=$( aws sts get-caller-identity --query Account --output text )
  log "AWS account ${awsAccountId}"
  aws ecr get-login-password \
     --region eu-west-1 | helm registry login \
     --username AWS \
     --password-stdin "${awsAccountId}.dkr.ecr.eu-west-1.amazonaws.com"

  autoapprove=""
  if [ "${GITHUB_ACTIONS}" == "true" ]; then
    autoapprove="-auto-approve"
  fi

  pushd "services/${service}/stack/${env}/deployment" || exit  
    terraform init
    terraform apply "${autoapprove}"
  popd || exit  
}



test-kubeservice() {
    mustVar service
    h1 "TESTING service=${service}"
    go vet "./services/${service}/..."
    go test -timeout 180s -count=1 --parallel=6 "./services/${service}/"
}

