check-updates() {
  ## Check for updates from GitHub main. If updates are found, prompts to overwrite local files.
  ## Silently skips if curl is missing. Exits 3 if updates are available.
  local repo
  repo="https://raw.githubusercontent.com/totomz/shmake/main"
  
  if ! command -v curl &>/dev/null; then
    errorLog "check-update error: missing tool curl"    
    return 0
  fi

  if ! command -v diff &>/dev/null; then
    errorLog "check-update error: missing tool diff"
    return 0
  fi
  
  local SCRIPT_DIR=""
  SCRIPT_DIR=$(dirname "$(realpath "${BASH_SOURCE[0]}")")

  local remote_tmp work_dir
  remote_tmp=$(mktemp)
  work_dir=$(mktemp -d)

  # Download the remote shMakefile
  curl -sf "${repo}/shMakefile" -o "$remote_tmp"

  _split_file() {
    local file=$1 prefix=$2
    local top_end bottom_start
    top_end=$(grep -m1 -Fn "# --. KEEP ME" "${file}" | cut -d: -f1)
    bottom_start=$(grep -m1 -Fn "# KEEP ME ==" "${file}" | cut -d: -f1)
    head -n "${top_end}" "${file}" > "${work_dir}/${prefix}_top"
    tail -n +"${bottom_start}" "${file}" > "${work_dir}/${prefix}_bottom"
    sed -n "$((top_end + 1)),$((bottom_start - 1))p" "${file}" > "${work_dir}/${prefix}_middle"
  }

  _split_file "${SCRIPT_DIR}/shMakefile" "_local"
  _split_file "$remote_tmp" "_remote"
  rm -f "$remote_tmp"

  local functions_tmp
  functions_tmp=$(mktemp)
  if curl -sf "${repo}/functions.sh" -o "$functions_tmp"; then
    if ! diff -w -q "$functions_tmp" "${SCRIPT_DIR}/functions.sh" &>/dev/null; then
      echo "New functions.sh version found."
      read -r -p "Apply updates to functions.sh? [y/N] " _answer
      if [[ "$_answer" =~ ^[Yy]$ ]]; then
        mv "$functions_tmp" "${SCRIPT_DIR}/functions.sh"
      fi
    fi
  fi
  rm -f "$functions_tmp"

  local has_diff=false
  if ! diff -w -q "${work_dir}/_local_top" "${work_dir}/_remote_top" &>/dev/null; then
    has_diff=true
  fi
  if ! diff -w -q "${work_dir}/_local_bottom" "${work_dir}/_remote_bottom" &>/dev/null; then
    has_diff=true
  fi

  if [[ "$has_diff" == true ]]; then
    echo "New shMakefile version found."
    read -r -p "Apply updates to shMakefile? [y/N] " _answer
    if [[ "$_answer" =~ ^[Yy]$ ]]; then
      # Bash reads scripts in buffered chunks, not all at once.
      # If the script file is overwritten while running, bash may read
      # a mix of old and new content — with unpredictable results.
      # To be safe, put the overwrite command and `exit` on the same line:
      # bash parses the full line before executing any of it.
      cat "${work_dir}/_remote_top" "${work_dir}/_local_middle" "${work_dir}/_remote_bottom" > "${SCRIPT_DIR}/shMakefile" && rm -rf "$work_dir" ; exit 0
    fi
  fi

  rm -rf "$work_dir"
}

_show-help() {
  # Print the script usage documentation
  # Hidden functions (that starts with `_` ) are also hidden in the doc
  # (but if you add ## comments, they will show up randomly - it's bash, give me a break)
  
  echo "Usage: $(basename "$0") <function> [--var=value ...]"
  echo ""
  local _files=("$0")
  shopt -s globstar
  for _f in ./**/shMakefile; do
    [[ "$_f" == "./shMakefile" ]] && continue
    [[ "$_f" == ./examples/* ]] && continue
    _files+=("$_f")
  done
  awk '
    /^[[:alpha:]][[:alnum:]_-]*\(\)/ {
      if (fname != "") { names[++n] = fname; descs[fname] = desc }
      fname = $0; gsub(/\(\).*/, "", fname)
      if (fname ~ /^_/) { fname = ""; desc = ""; collecting = 0; next }
      desc = ""; fargs[fname] = ""; lcount[fname] = 0; collecting = 1; next
    }
    fname && /^[[:space:]]*##($|[^#])/ {
      line = $0; gsub(/^[[:space:]]*##[[:space:]]?/, "", line)
      desc = desc line "\n"; next
    }
    fname && collecting && /^[[:space:]]*mustVar[[:space:]]/ {
      line = $0
      varname = line; gsub(/^[[:space:]]*mustVar[[:space:]]+/, "", varname); gsub(/[[:space:]].*/, "", varname)
      comment = ""
      if (line ~ /#/) { comment = line; gsub(/^[^#]*#[[:space:]]*/, "", comment) }
      entry = "  --" varname "=<value>  required"
      if (comment != "") entry = entry "  " comment
      req[fname, varname] = 1
      fargs[fname] = fargs[fname] entry "\n"
      next
    }
    fname && collecting && /^[[:space:]]*local[[:space:]]/ {
      if ($0 !~ /#/) { next }
      line = $0
      varname = line; gsub(/^[[:space:]]*local[[:space:]]+/, "", varname); gsub(/[=[:space:]].*/, "", varname)
      comment = line; gsub(/^[^#]*#[[:space:]]*/, "", comment)
      lcount[fname]++
      lvar[fname, lcount[fname]] = varname
      lentry[fname, lcount[fname]] = "  --" varname "=<value>  optional  " comment
      next
    }
    fname && collecting && /^[[:space:]]*$/ { next }
    fname && collecting { collecting = 0 }
    END {
      if (fname != "") { names[++n] = fname; descs[fname] = desc }
      flist = ""
      for (i = 1; i <= n; i++) flist = flist (i > 1 ? " | " : "") names[i]
      print "Functions: " flist
      print ""
      for (i = 1; i <= n; i++) {
        f = names[i]
        printf "### %s\n", f
        if (descs[f] != "") printf "%s", descs[f]
        combined = fargs[f]
        for (j = 1; j <= lcount[f]; j++) {
          if (!req[f, lvar[f, j]]) combined = combined lentry[f, j] "\n"
        }
        if (combined != "") printf "%s", combined
        print ""
      }
    }
  ' "${_files[@]}"
}

# Parse arguments.
# The first argument is the target to invoke, followed by variables
TARGET=$1
shift || true

if [[ -z "$TARGET" || "$TARGET" == "-h" || "$TARGET" == "--help" ]]; then
  _show-help
  exit 0
fi

while [[ $# -gt 0 ]]; do
  v=$1
  shift
  if [[ $v == --* ]]; then
    key=$(echo "$v" | awk -F= '{print $1}' | sed 's/-//g')
    value=$(echo "$v" | awk -F= '{print $2}')

    eval "${key}=${value}"
  fi
done

eval "${TARGET}"
